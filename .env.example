# Required
ADMIN_USER=admin                     # Initial admin username
ADMIN_PASS=changeme                  # Initial admin password
JWT_SECRET=your-secret-key-min-32    # JWT signing secret (min 32 chars)

# Database
DATABASE_PATH=./data/invoice.db      # SQLite database file path

# Server
PORT=3000                            # Server port
HOST=0.0.0.0                         # Server host
PUBLIC_BASE_URL=                     # Public origin (e.g. https://invoices.example.com) used in password-reset links,
                                     # and also required for payment links in scheduler-sent mail (recurring auto-send
                                     # and the auto-bill payment-link fallback), which have no live request to read an
                                     # origin from. Leave it unset and those emails omit the link entirely.

# Security
SESSION_TTL=3600                     # JWT token lifetime in seconds (default: 1 hour)
COOKIE_SECURE=true                   # Use secure cookies (false for HTTP dev)
ENABLE_HSTS=false                    # Enable HSTS header
RATE_LIMIT_ENABLED=true              # Enable login rate limiting
RATE_LIMIT_MAX_ATTEMPTS=5            # Max failed login attempts
RATE_LIMIT_WINDOW=900                # Rate limit window in seconds

# OIDC / SSO (optional) — set OIDC_ISSUER_URL to enable single sign-on
OIDC_ISSUER_URL=                        # Issuer URL, e.g. https://auth.example.com/realms/inkvoice (https only)
OIDC_CLIENT_ID=                         # OIDC confidential client id
OIDC_CLIENT_SECRET=                     # OIDC confidential client secret
OIDC_SCOPE=openid email profile         # Space-separated scopes (openid is always included)
OIDC_ALLOWED_DOMAINS=                   # Optional: comma-separated email domains allowed to self-register
OIDC_AUTO_PROVISION=true                # Create a Viewer account on first SSO login (false = pre-provisioned only)
OIDC_PROVIDER_NAME=                     # Optional: login button label, e.g. "Google Workspace"

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000  # Comma-separated allowed origins

# Email (SMTP) — optional, enables invoice sending
SMTP_HOST=                           # SMTP server hostname
SMTP_PORT=587                        # SMTP server port
SMTP_USER=                           # SMTP username
SMTP_PASS=                           # SMTP password
SMTP_FROM=                           # Sender email address
SMTP_SECURE=false                    # Use TLS (true for port 465)

# Stripe (Online Payments) — optional; all three keys required to enable
STRIPE_SECRET_KEY=                   # Stripe secret key (sk_...)
STRIPE_PUBLISHABLE_KEY=              # Stripe publishable key (pk_...)
STRIPE_WEBHOOK_SECRET=               # Stripe webhook signing secret (whsec_...) — required

# PayPal (Online Payments) — optional; client ID, secret and webhook ID required to enable
PAYPAL_CLIENT_ID=                    # PayPal REST app client ID
PAYPAL_SECRET=                       # PayPal REST app secret
PAYPAL_WEBHOOK_ID=                   # Webhook ID from the PayPal app (for signature verification) — required
PAYPAL_ENV=sandbox                   # sandbox | live

# Optional
DEMO_MODE=false                      # Enable demo mode with periodic resets. Defaults ADMIN_USER/ADMIN_PASS
                                     # to demo/demo and shows them on the login page. Clear the two values
                                     # above to pick that up, since setting them here overrides the default.
                                     # Also seeds a demo company profile (onboarding pre-completed) and, on
                                     # an empty database, the sample customers/products/invoices at boot.
DEMO_RESET_INTERVAL=86400000         # Demo reset interval in milliseconds (default: 24 hours)
SLACK_WEBHOOK_URL=                   # Slack incoming-webhook URL; if set, in-app feedback is mirrored here

# PEPPOL e-invoice transport (optional). Set these to send/receive e-invoices
# over the PEPPOL network via peppol.sh. Credentials live here (env only, never
# in the database); the feature toggle lives in Settings.
PEPPOL_SH_API_KEY=                   # peppol.sh API key. Presence enables the peppol-sh driver.
PEPPOL_SH_WEBHOOK_SECRET=            # HMAC secret verifying inbound callbacks; without it inbound is refused
PEPPOL_SH_BASE_URL=https://api.peppol.sh   # Override for sandbox or a self-hosted proxy. Must be https.

